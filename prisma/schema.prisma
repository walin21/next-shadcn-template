generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
  ASSISTANT
  USER
}

model Office {
  officeId  String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("offices")
}

model User {
  userId    String   @id @default(uuid())
  email     String   @unique
  password  String
  phone     String?
  name      String
  lastName  String?
  role      UserRole @default(USER)
  officeId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices Office? @relation(fields: [officeId], references: [officeId])

  @@map("users")
}
